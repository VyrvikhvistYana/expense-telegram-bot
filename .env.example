# Telegram: @BotFather → /newbot → token
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (empty = allow all)
# Get your id: message @userinfobot
ALLOWED_USER_IDS=

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Sheets: spreadsheet id from the URL
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_ID=

# Path to service account JSON key (download from Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# Sheet tab name (must match the tab in your spreadsheet)
GOOGLE_SHEET_TAB=Expenses
